# Skopiuj ten plik do .env i uzupełnij prawdziwe wartości.
# Nigdy nie commituj pliku .env z prawdziwymi sekretami!

# --- Django ---
DJANGO_SECRET_KEY=zmien-mnie-na-losowy-dlugi-ciag-znakow
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,twoja-domena.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://twoja-domena.pl
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
# Ustaw TYLKO gdy aplikacja stoi za reverse proxy pod prefiksem innym niż "/"
# (np. Caddy handle_path /kalkulator-terminu/* na współdzielonej domenie z
# inną aplikacją) — inaczej zostaw puste/niewpisane.
# DJANGO_FORCE_SCRIPT_NAME=/kalkulator-terminu

# --- Baza danych (docker-compose zbuduje DATABASE_URL automatycznie z poniższych) ---
POSTGRES_DB=kalkulator
POSTGRES_USER=kalkulator
POSTGRES_PASSWORD=zmien-mnie-na-silne-haslo

# Dla uruchomienia bez docker-compose (np. lokalnie) można też ustawić bezpośrednio:
# DATABASE_URL=postgres://kalkulator:haslo@localhost:5432/kalkulator

# --- Port na hoście, pod którym aplikacja będzie dostępna ---
WEB_PORT=8010

# --- Import ---
IMPORT_MAX_UPLOAD_SIZE_MB=15
STALE_DATA_WARNING_HOURS_DEFAULT=24

# --- Rate limiting publicznego kalkulatora ---
CALCULATOR_RATE_LIMIT_COUNT=30
CALCULATOR_RATE_LIMIT_WINDOW_SECONDS=60

# --- Automatyczne utworzenie konta administratora przy pierwszym starcie ---
# Zostaw puste, aby pominąć i utworzyć konto ręcznie przez `manage.py createsuperuser`.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
